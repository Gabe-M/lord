{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lord",
  "version": "0.1.0",
  "identifier": "com.cleb.verity",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lord",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 360,
        "maxWidth": 1280,
        "maxHeight": 980,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lord",
  "version": "0.1.0",
  "identifier": "com.cleb.verity",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lord",
        "width": 280,
        "height": 280,
        "minWidth": 154,
        "minHeight": 154,
        "maxWidth": 616,
        "maxHeight": 616,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true
      },
      {
        "label": "chat",
        "title": "Lord - Terminal",
        "width": 420,
        "height": 540,
        "minWidth": 320,
        "minHeight": 300,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
